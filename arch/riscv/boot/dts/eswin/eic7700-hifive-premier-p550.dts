/dts-v1/;

#define CMA_SIZE		0x20000000

#include "eic7700.dtsi"
#include "hifive-premier-p550-pinctrl.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>

/* Clock frequency (in Hz) of the PCB crystal for rtcclk */

/ {
	compatible = "sifive,hifive-premier-p550", "eswin,eic7700";
	model = "SiFive HiFive Premier P550";

	aliases {
		serial0 = &uart0;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x7f 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 CMA_SIZE>;
			alignment = <0x0 0x1000>;
			linux,cma-default;
		};

		npu0_reserved: sprammemory@59000000 {
			no-map;
			reg = <0x0 0x59000000 0x0 0x400000>;
		};

		lpcpu0_reserved: lpcpu@a0000000 {
			no-map;
			reg = <0x0 0xa0000000 0x0 0x100000>;
		};

		g2d_4GB_boundary_reserved_4k {
			no-map;
			reg = <0x0 0xfffff000 0x0 0x1000>;
		};
	};

	reg_vcc1v8: vcc1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

&clk {
	status = "okay";
};

&reset {
	status = "okay";
};

&smmu0 {
	status = "okay";
};

&pcie {
	/* GPIO12 PCIE PRSNT input */
	status = "okay";
};

&gpu0 {
	status = "okay";
};

&video_output {
	status = "okay";
};

&dc {
	status = "okay";
};

&dw_hdmi {
	status = "okay";
	ports {
		port@2 {
			reg = <2>;
			hdmi_in_i2s: endpoint@1 {
				system-clock-frequency = <12288000>;
				remote-endpoint = <&i2s0_endpoint>;
			};
		};
	};
};

&i2s0 {
	status = "okay";
	i2s0_port: port {
		i2s0_endpoint: endpoint {
			remote-endpoint = <&hdmi_in_i2s>;
			dai-format = "i2s";
		};
	};
};

&i2s1 {
	status = "okay";
	i2s1_port: port {
		i2s1_endpoint: endpoint {
			remote-endpoint = <&d0_codec0_endpoint>;
			dai-format = "i2s";
		};
	};
};

&graphcard0 {
	status = "okay";
	dais = <&i2s1_port>;
};

&graphcard1 {
	status = "okay";
	dais = <&i2s0_port>;
};

&sdhci_emmc {
	/* emmc */
	status = "okay";
	delay_code = <0x17>;
	drive-impedance-ohm = <50>;
	enable-cmd-pullup;
	enable-data-pullup;
	no-sdio;
	no-sd;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_led_ctrl_pins>;
};

&sdio0 {
	/* sd card */
	status = "okay";
	delay_code = <0x55>;
	drive-impedance-ohm = <33>;
	enable-cmd-pullup;
	enable-data-pullup;
	no-sdio;
	no-mmc;
};

&sdio1 {
	/* wifi module */
	status = "okay";
	delay_code = <0x29>;
	drive-impedance-ohm = <33>;
	enable-cmd-pullup;
	enable-data-pullup;
	non-removable;
	no-sd;
	no-mmc;
};

&gmac0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&gpio106_pins>;
	rst-gpios = <&gpioD 10 GPIO_ACTIVE_LOW>;
	eswin,rgmiisel = <&pinctrl 0x290 0x3>;
	eswin,led-cfgs = <0x6100 0xa40 0x420>;
};

&gmac1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&gpio111_pins>;
	rst-gpios = <&gpioD 15 GPIO_ACTIVE_LOW>;
	eswin,rgmiisel = <&pinctrl 0x294 0x3>;
	eswin,led-cfgs = <0x6100 0xa40 0x420>;
};

&sata {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sata_act_led_pins>;
};

&usbdrd3_0 {
	status = "okay";
};

&usbdrd_dwc3_0 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "super-speed";
};

&usbdrd3_1 {
	status = "okay";
};

&usbdrd_dwc3_1 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "super-speed";
};

&dmac {
	status = "okay";
};

&aon_dmac {
	status = "okay";
};

&uart0 {
	/* debug */
	status = "okay";
};

&uart1 {
	/* M.2 KEY E */
	status = "okay";
};

&uart2 {
	/* connect MCU */
	status = "okay";
};

&bootspi {
	/* spi flash */
	status = "okay";
	num-cs = <1>;
	cs-gpios = <&gpioD 0 GPIO_ACTIVE_LOW>;
	wp-gpios = <&gpioD 4 GPIO_ACTIVE_LOW>;
	spi-flash@0 {
		compatible = "winbond,w25q128jw",
					"jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <4800000>;
		rx-sample-delay-ns = <10>;
	};
};

&fan_control {
	status = "okay";
};

&i2c0 {
	/* codec es8388 */
	status = "okay";
	d0_es8388_0: es8388-0@11 {
		compatible = "eswin,es8388";
		reg = <0x11>;
		#sound-dai-cells = <0>;
		eswin-plat = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&gpio0_pins &gpio28_pins>;
		front-jack-gpios = <&gpioA 0 GPIO_ACTIVE_HIGH>;
		back-jack-gpios = <&gpioA 28 GPIO_ACTIVE_HIGH>;
		port {
			d0_codec0_endpoint: endpoint {
				system-clock-frequency = <12288000>;
				remote-endpoint = <&i2s1_endpoint>;
			};
		};
	};
};

&i2c1 {
	status = "okay";
};

&i2c3 {
	/* FUSB303B cc logic */
	status = "okay";
	fusb303b@21 {
		compatible = "fcs,fusb303b";
		status = "okay";
		reg = <0x21>;
		eswin,syscfg = <&sys_con 0x3C0 12>;
		int-gpios = <&gpioA 5 GPIO_ACTIVE_HIGH>;
		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "host";
		};
	};
};

&i2c5 {
	/* TCA9548 */
	status = "okay";
};

&aon_i2c0 {
	/* AT24C02C EEPROM */
	status = "okay";
	eswin,syscfg = <&sys_con 0x3C0 16>;
	aon_eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
	};
};

&aon_i2c1 {
	/* INA226 & PAC1934 */
	status = "okay";
	eswin,syscfg = <&sys_con 0x3C0 15>;
	i2c-sda-hold-time-ns = <0x40>;

	pac1934:pac1934@10 {
		compatible = "microchip,pac1934";
		reg = <0x10>;

		#address-cells = <1>;
		#size-cells = <0>;

		channel@1 {
			reg = <0x1>;
			shunt-resistor-micro-ohms = <1000>;
			label = "som vdd";
		};

		channel@2 {
			reg = <0x2>;
			shunt-resistor-micro-ohms = <1000>;
			label = "soc vdd";
		};

		channel@3 {
			reg = <0x3>;
			shunt-resistor-micro-ohms = <1000>;
			label = "cpu vdd";
		};

		channel@4 {
			reg = <0x4>;
			shunt-resistor-micro-ohms = <1000>;
			label = "ddr lpvdd";
		};
	};

	sys_power:ina226@44 {
		compatible = "ti,ina226";
		#io-channel-cells = <1>;
		label = "sys_power";
		reg = <0x44>;
		shunt-resistor = <1000>;
	};
};

&pwm0 {
	/* fan */
	status = "okay";
};

&pvt0 {
	status = "okay";
};

&pvt1 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&wdt1 {
	status = "okay";
};

&wdt2 {
	status = "okay";
};

&wdt3 {
	status = "okay";
};

&pinctrl {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&gpio6_pins &gpio7_pins
		&gpio8_pins &gpio9_pins
		&gpio10_pins &gpio17_pins
		&gpio35_pins &gpio36_pins
		&gpio37_pins &gpio38_pins
		&gpio39_pins &gpio40_pins
		&gpio41_pins &gpio52_pins
		&gpio53_pins &gpio64_pins
		&gpio65_pins &gpio66_pins
		&gpio67_pins &gpio70_pins
		&gpio73_pins &gpio83_pins
		&gpio86_pins &gpio87_pins
		&gpio92_pins &gpio93_pins>;

    /* pin header default function for GPIO
       SPI1 (CS0,SCLK,MOSI,MISO,D2,D3): GPIO 35,36,37,38,39,40
       I2C1 (SCL,SDA): GPIO 46,47
       UART3(TX,RX): GPIO 92,93
    */
};
